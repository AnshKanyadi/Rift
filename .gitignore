# Build output
/bin/
/build/
*.a
*.o
*.so
*.dylib
*.test
*.out

# `go build ./cmd/<name>` drops an EXTENSIONLESS binary in the working
# directory, which no suffix rule above can catch. riftnode was committed that
# way at 32647de and sat in the tree as the largest tracked file in the repo.
# One line per cmd/ target, so a new command is a conscious addition here.
/riftnode
/simctl
/shapename

# Go
/vendor/
coverage.out
cpu.prof
mem.prof
trace.out

# CMake / C++ (Track B)
engine-cpp/build/
engine-cpp/build-*/
CMakeCache.txt
CMakeFiles/
compile_commands.json

# Engine roots written at a RELATIVE path, so they land wherever the lane ran.
# engine-cpp/test/tsan_harness_test.cc hardcodes this one and leaves the
# directory behind; `make cpp-tsan` from the repo root therefore creates it here.
/tsan-flush-db/

# Simulator artifacts
# NOTE: seeds/ IS tracked -- the failing-seed corpus is a deliverable.
# These are transient run outputs, not corpus entries.
/runs/
/soak-out/
*.trace.jsonl
*.trace.jsonl.zst

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Worktrees created as siblings are outside the repo; this catches the
# in-repo layout if we ever switch to it.
/.worktrees/
.exitrun
.exitrun.log
