+// proposedSplit is the rejected design from DESIGN-A4 section 4: the leader
+// creates the right-hand range when it PROPOSES, out of band, instead of every
+// replica deriving it when the entry applies.
+func (m *Node) proposedSplit(left *Replica, spec SplitSpec, index raft.Index, at clock.Instant, s sim.Scheduler) bool {
+	if !left.IsLeader() || m.replicaOf(spec.Right.ID) != nil {
+		return false
+	}
+	r, err := m.newReplicaFor(spec.Right)
+	if err != nil {
+		return false
+	}
+	conf, confErr := left.raft.ConfigurationAt(index)
+	if confErr != nil {
+		return false
+	}
+	snapMeta := raft.SnapshotMeta{Index: 0, Term: 0, Conf: conf}
+	data := encodeMachine(spec.Right, map[string]string{})
+	b := engine.NewBatch()
+	b.Set(keyDescOf(spec.Right.ID), encodeDesc(spec.Right))
+	b.Set(keySnapshotOf(spec.Right.ID), encodeSnapshot(snapMeta, data))
+	if seq, err := m.db.Apply(b, true); err == nil {
+		r.durSnap = snapMeta
+		s.At(at+m.cfg.SyncLatency, sim.KindDurable, sim.NodeID(m.cfg.Ordinal),
+			sim.Stamp(m.epoch.Current(), seq))
+	}
+	m.cfg.Ledger.RecordRangeBase(uint64(spec.Right.ID),
+		provenance.Witness(data), provenance.Witness(raft.EncodeConfiguration(conf)))
+	r.adoptSnapshot(snapMeta, map[string]string{})
+	m.addReplica(r)
+	return false
+}
