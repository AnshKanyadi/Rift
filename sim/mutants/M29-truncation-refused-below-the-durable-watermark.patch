# id: M29-truncation-refused-below-the-durable-watermark
# covering-test: TestStateMachineSafetyOracleReportsNothing
# package: ./sim/hunt/
# expect: killed
# power-seeds: 300
# power-floor: 8
# power-ceiling: 24
# power-measured: 21 of 300, first at seed 1, under current at commit A5-close; was 23 of 300 first at seed 1 under the same shape at A4-close
# mutates: truncation refuses to discard entries below the DURABLE watermark instead of below the COMMIT index. Raft section 5.3 has a follower delete a conflicting entry and everything after it, and those entries are routinely already on disk -- so a persisted suffix being overwritten is the protocol working, and only a COMMITTED entry may never be overwritten. The mutant asserts the stronger, false thing, and panics on legitimate truncations
# note: the patch replaces ONE LINE -- the condition -- and deliberately leaves the panic's message alone.
# It used to rewrite the message too, and that was a mistake with a mechanical cost: the message rewrite
# made the hunk TWO contiguous runs rather than one, and the second run's first line is inside the panic's
# argument list, which only evaluates when state machine safety has already failed. `make mutant-covered`
# therefore reported this class DEAD forever, asking for a covering test that breaks the invariant
# (DESIGN-A6 sections 36, 36.4). The message is cosmetic to the class; the condition IS the class.
# re-anchored: 2026-08-27, tools/anchorcheck. Context regenerated so the hunk anchors on CODE
#   rather than on prose. The mutation is unchanged and was proved so: the old patch and this
#   one were applied to clean copies and the results are byte-identical.
--- a/raft/raft.go
+++ b/raft/raft.go
@@ -2887,33 +2887,33 @@ func (r *Raft) truncateFrom(i Index) {
 	}
 	// # What may never be truncated is COMMITTED, not durable
 	//
 	// The assertion that stood here refused any truncation at or below the
 	// durable watermark, on the reasoning that the driver would then have
 	// acknowledged an entry that later vanished. That is a stronger claim than
 	// Raft makes, and it is false: §5.3 has a follower delete a conflicting
 	// entry and everything after it, and those entries are routinely already on
 	// disk. A follower's persisted suffix being overwritten by a new leader is
 	// the protocol working. What Raft guarantees is that a COMMITTED entry is
 	// never overwritten, because the up-to-date check keeps a candidate missing
 	// one from ever winning.
 	//
 	// The false assertion sat here unreachable for as long as tail.persisted
 	// never moved -- which is the same defect twice: a claim nothing exercised,
 	// guarding a watermark nothing advanced.
-	if r.commitIndex >= i {
+	if r.tail.persisted >= i {
 		panic(fmt.Sprintf(
 			"raft: node %d truncated to %d with commit index %d; an entry this node was told "+
 				"was committed is being overwritten, which is state machine safety failing",
 			r.id, i, r.commitIndex))
 	}
 
 	if i <= r.snapIndex {
 		panic(fmt.Sprintf(
 			"raft: node %d truncated to %d with a snapshot at %d; the entries being discarded are "+
 				"already in the snapshot, which means an applied prefix is being rewritten",
 			r.id, i, r.snapIndex))
 	}
 	p, ok := r.pos(i)
 	if !ok {
 		panic(fmt.Sprintf("raft: node %d truncated to %d, which its log does not hold", r.id, i))
 	}
