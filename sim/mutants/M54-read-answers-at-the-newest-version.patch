# mutates: a read at a timestamp seeks to the key's prefix instead of to the timestamp, so it answers with the NEWEST version rather than the one visible where it asked. Every read at now still returns the right value, which is why a workload without snapshot reads cannot see this at all: it is the defect that makes an MVCC store indistinguishable from a single-version one
--- a/kv/store.go
+++ b/kv/store.go
@@ -125,7 +125,7 @@
 
 	// Versions sort newest-first within a key, so the first record at or after
 	// the encoding of (key, ts) is the newest version at or before ts.
-	if !it.SeekGE(EncodeKey(s.ns, key, ts)) {
+	if !it.SeekGE(prefix) {
 		return nil, false, it.Error()
 	}
 	gotKey, gotTS, ok := DecodeKey(s.ns, it.Key())
