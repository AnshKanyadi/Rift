# mutates: a truncation removes a configuration entry without rebuilding the active configuration, so the node goes on using a membership its own log no longer describes -- DESIGN-A3 §3 names this as where the bugs live
--- a/raft/raft.go
+++ b/raft/raft.go
@@ -2347,11 +2347,7 @@
 	}
 	r.gated = kept
 
-	// A truncation can remove a configuration entry, so the active configuration
-	// has to be rebuilt from what the log now says. Recomputed from scratch
-	// rather than undone: an undo that is one case short is a cluster that
-	// disagrees with itself about who is in it.
-	r.recomputeConf()
+	// mutated: the recompute is gone
 }
 
